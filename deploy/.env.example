# Used by docker-compose.yml (api container + nginx). Generated for you by install.sh.
DOMAIN=chat.example.com
PUBLIC_URL=https://chat.example.com
CORS_ORIGINS=https://chat.example.com
WEBAUTHN_RP_ID=chat.example.com

# openssl rand -base64 48
JWT_SECRET=
# openssl rand -base64 32
SETTINGS_ENCRYPTION_KEY=

LOG_LEVEL=info
EXPOSE_OPENAPI=false
# Restrict the admin API to your office / VPN (comma separated IPs or CIDRs); empty = no restriction
ADMIN_IP_ALLOWLIST=
