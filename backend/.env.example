# VibeMatch v2 backend — every variable is validated at boot (src/config/env.ts).
# cp .env.example .env

NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# Public base URL. MUST be https in production.
PUBLIC_URL=http://localhost:3000
# Express "trust proxy" value: loopback | 1 | 10.0.0.0/8 ...  (set when behind nginx / a load balancer)
TRUST_PROXY=loopback
# Comma separated browser origins allowed by CORS (no "*"). Required in production.
CORS_ORIGINS=http://localhost:5173
BODY_LIMIT=1mb

# --- MongoDB (connection pool) ---
MONGODB_URI=mongodb://127.0.0.1:27017/vibematch
MONGO_MAX_POOL_SIZE=20
MONGO_MIN_POOL_SIZE=2
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000
MONGO_SOCKET_TIMEOUT_MS=45000
MONGO_MAX_IDLE_TIME_MS=60000
# Set false in production and run `npm run db:indexes` during deploys.
MONGO_AUTO_INDEX=true

# --- Redis (optional): shared rate limits, cache, socket.io adapter, matching queue ---
# REDIS_URL=redis://127.0.0.1:6379

# --- Auth ---
# openssl rand -base64 48
JWT_SECRET=
JWT_ISSUER=vibematch
JWT_AUDIENCE=vibematch-clients
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_COST=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# 32 random bytes, base64: openssl rand -base64 32  (encrypts secrets stored in settings)
# SETTINGS_ENCRYPTION_KEY=

# --- Admin hardening ---
# Comma separated IPs/CIDRs allowed to call /api/v1/admin/* (empty = no IP restriction)
ADMIN_IP_ALLOWLIST=
REQUIRE_ADMIN_PASSKEY=false
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=VibeMatch
# Origins that may perform WebAuthn ceremonies (defaults to PUBLIC_URL + CORS_ORIGINS)
WEBAUTHN_ORIGINS=

# --- Rate limiting (per WINDOW) ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_GLOBAL=300
RATE_LIMIT_USER=240
RATE_LIMIT_AUTH=10
RATE_LIMIT_SENSITIVE=20

# --- Logging (asynchronous, buffered) ---
LOG_LEVEL=info
LOG_FLUSH_MS=1000

# --- Misc ---
DEMO_MODE=false
# Serve GET /openapi.json
EXPOSE_OPENAPI=true
HISTORY_TTL_DAYS=180
AUDIT_TTL_DAYS=365
CACHE_TTL_SECONDS=60

# --- Payments ---
ANDROID_PACKAGE_NAME=com.vibematch.app
PAYPAL_ENV=sandbox
PAYMENT_CURRENCY=USD
# Firebase Admin service account (verifies social sign-in tokens, sends push)
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'
# GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'
# APPLE_SHARED_SECRET=
